---
import Layout from "../layouts/Layout.astro";
import BootSequence from "../components/BootSequence.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/Hero.astro";
import Arsenal from "../components/Arsenal.astro";
import Builds from "../components/Builds.astro";
import MissionLog from "../components/MissionLog.astro";
import Transmissions from "../components/Transmissions.astro";
import Channel from "../components/Channel.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout>
    <BootSequence slot="overlay" />
    <NavBar slot="header" />
    <Hero />
    <Arsenal />
    <Builds />
    <MissionLog />
    <Transmissions />
    <Channel />
    <SiteFooter slot="footer" />
</Layout>
