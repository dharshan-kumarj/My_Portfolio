---
import "../styles/global.css";

const title =
    "Dharshan Kumar J | Software Engineer · AI Systems · Cloud & DevOps · Web3";
const description =
    "Software Engineer specializing in AI Systems, Backend Engineering, Cloud & DevOps, and Web3. Building production-grade ML pipelines, RAG systems, scalable backend APIs, and decentralized applications.";
const socialTitle =
    "Dharshan Kumar J | Software Engineer · AI · Cloud & DevOps · Web3";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/jpeg" href="/Dharshan.jpeg" />
        <meta name="generator" content={Astro.generator} />

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content="Dharshan Kumar J" />

        <!-- Runs before paint: decides whether the boot sequence and
             scroll reveals run. Reduced-motion visitors get neither. -->
        <script is:inline>
            (function () {
                var root = document.documentElement;
                var reduce = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches;
                if (reduce) return;
                root.classList.add("motion-ok");
                var booted = false;
                try {
                    booted = sessionStorage.getItem("iron-aura-booted") === "1";
                } catch (e) {}
                if (!booted) root.classList.add("booting");
            })();
        </script>

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Orbitron:wght@500;600;700;800&family=Rajdhani:wght@500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css"
        />

        <!-- Keywords for SEO -->
        <meta
            name="keywords"
            content="software engineer, AI systems, machine learning, backend engineering, cloud DevOps, Web3, Golang developer, FastAPI, RAG system, LLM, smart contract, Ethereum, Prometheus, Grafana, ChromaDB, Scikit-Learn, SHAP, Slither, Python, REST API"
        />
        <meta name="robots" content="index, follow" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={socialTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="/Dharshan.jpeg" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:title" content={socialTitle} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content="/Dharshan.jpeg" />

        <meta name="theme-color" content="#0a0a0c" />
        <meta name="copyright" content="Dharshan Kumar J" />
    </head>
    <body>
        <a
            href="#main"
            class="hud sr-only z-[60] bg-reactor px-4 py-2 focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
            >Skip to content</a
        >
        <slot name="overlay" />
        <slot name="header" />
        <main id="main">
            <slot />
        </main>
        <slot name="footer" />

        <script>
            import "../scripts/motion";
        </script>
    </body>
</html>
